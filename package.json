{
  "name": "mwps",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy-zip": "vite build && rm -f dist/mwps-web.zip && cd dist/web && zip -qr ../mwps-web.zip .",
    "build:preset": "node scripts/build-preset.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "MWPS_E2E=1 vite build && playwright test --project=e2e",
    "test:modules": "MWPS_E2E=1 vite build && playwright test --project=modules --pass-with-no-tests",
    "test:fuzz": "MWPS_E2E=1 vite build && playwright test --project=fuzz",
    "new": "node scripts/new-module.ts",
    "check": "node scripts/check-module.ts",
    "postinstall": "node scripts/install-module-deps.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.8.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "esbuild-wasm": "^0.28.2",
    "lucide-react": "^1.61.0",
    "prosemirror-collab": "^1.3.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-utils": "^1.2.2",
    "prosemirror-view": "^1.42.8",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0",
    "use-sync-external-store": "^1.7.0"
  }
}
